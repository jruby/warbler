<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Shared properties, plugin versions and the enforcer come from the root pom; the
       forked invoker builds resolve it via relativePath since they run in place. -->
  <parent>
    <groupId>org.jruby.warbler</groupId>
    <artifactId>warbler</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>integration-tests</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <properties>
    <!-- Test locations -->
    <warbler.gem>${basedir}/../../pkg/warbler-${revision}.gem</warbler.gem>
    <gem.home>${basedir}/../../pkg/rubygems-jruby-${jruby.version}-rack-${jruby-rack.version}</gem.home>
    <gem.path>${basedir}/../../pkg/rubygems-jruby-${jruby.version}-rack-${jruby-rack.version}</gem.path>
  </properties>

  <profiles>
    <profile>
      <id>ee8</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <jetty-maven-plugin.group>org.eclipse.jetty.ee8</jetty-maven-plugin.group>
        <jetty-maven-plugin.artifact>jetty-ee8-maven-plugin</jetty-maven-plugin.artifact>
        <jetty-maven-plugin.version>12.1.12</jetty-maven-plugin.version>
      </properties>
    </profile>
    <profile>
      <id>ee11</id>
      <activation>
        <property><name>jruby-rack.version</name><value>2.0</value></property>
      </activation>
      <properties>
        <jetty-maven-plugin.group>org.eclipse.jetty.ee11</jetty-maven-plugin.group>
        <jetty-maven-plugin.artifact>jetty-ee11-maven-plugin</jetty-maven-plugin.artifact>
        <jetty-maven-plugin.version>12.1.12</jetty-maven-plugin.version>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <defaultGoal>verify</defaultGoal>
    <resources>
      <resource>
        <directory>${basedir}/src/main/ruby</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- these modules use jar packaging only for the java IT lifecycle; suppress the
             meaningless default jar so only warble's artifact appears in target/ -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>${jetty-maven-plugin.group}</groupId>
          <artifactId>${jetty-maven-plugin.artifact}</artifactId>
          <version>${jetty-maven-plugin.version}</version>
          <configuration>
            <stopPort>9966</stopPort>
            <stopKey>warbler_stop</stopKey>
            <supportedPackagings>jar</supportedPackagings>
            <systemProperties>
              <systemProperty>
                <key>org.eclipse.jetty.util.log.class</key>
                <value>org.eclipse.jetty.util.log.StdErrLog</value>
              </systemProperty>
              <systemProperty>
                <key>org.eclipse.jetty.util.log.stderr.ESCAPE</key>
                <value>false</value>
              </systemProperty>
              <systemProperty>
                <key>org.eclipse.jetty.LEVEL</key>
                <!-- Change to DEBUG to be overloaded as to what Jetty is doing -->
                <value>INFO</value>
              </systemProperty>

              <!-- Enable to get more detailed debugging traces if necessary https://github.com/jruby/jruby/wiki/JRuby-Options -->
              <systemProperty>
                <key>jruby.backtrace.style</key>
                <value>full</value> <!-- normal|full|raw|mri -->
              </systemProperty>
              <systemProperty>
                <key>jruby.log.exceptions</key>
                <value>false</value> <!-- enable to find additional exceptions leading to another -->
              </systemProperty>
              <systemProperty>
                <key>jruby.log.backtraces</key>
                <value>false</value>
              </systemProperty>
            </systemProperties>
          </configuration>
          <executions>
            <execution>
              <id>start-jetty</id>
              <phase>pre-integration-test</phase>
              <goals>
                <!-- Change to run-war to interactively play with the server without running tests -->
                <goal>start-war</goal>
              </goals>
            </execution>
            <execution>
              <id>stop-jetty</id>
              <phase>post-integration-test</phase>
              <goals>
                <goal>stop</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jruby.maven</groupId>
          <artifactId>jruby-maven-plugin</artifactId>
          <configuration>
            <gemHome>${gem.home}</gemHome>
            <jrubyVersion>${jruby.version}</jrubyVersion>
          </configuration>
          <executions>
            <execution>
              <id>install-tool-gems</id>
              <phase>initialize</phase>
              <goals><goal>jruby</goal></goals>
              <configuration>
                <args>-S gem install --no-document --conservative jruby-jars:${jruby.version} jruby-rack:~&gt;${jruby-rack.version}.0</args>
              </configuration>
            </execution>
            <execution>
              <id>install-warbler</id>
              <phase>initialize</phase>
              <goals><goal>jruby</goal></goals>
              <configuration>
                <args>-S gem install --no-document ${warbler.gem}</args>
              </configuration>
            </execution>
            <execution>
              <id>bundle-install</id>
              <goals><goal>jruby</goal></goals>
              <configuration>
                <env>
                  <BUNDLE_VERSION>system</BUNDLE_VERSION>
                  <BUNDLE_DISABLE_SHARED_GEMS>true</BUNDLE_DISABLE_SHARED_GEMS>
                  <BUNDLE_GLOBAL_GEM_CACHE>true</BUNDLE_GLOBAL_GEM_CACHE>
                </env>
                <args>-C ${basedir}/src/main/ruby -S bundle install</args>
              </configuration>
            </execution>
            <execution>
              <id>warble</id>
              <goals><goal>jruby</goal></goals>
              <configuration>
                <args>-C ${basedir}/src/main/ruby -S ${gem.home}/bin/warble</args>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
